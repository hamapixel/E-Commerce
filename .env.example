# ============================================================
# SUGU KURA - Docker / Coolify
# Copiez ce fichier en .env uniquement pour le test Docker local.
# Dans Coolify, configurez ces valeurs dans Environment Variables.
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
APP_TIME_ZONE=Africa/Bamako

# PostgreSQL
DB_NAME=sugu_kura_db
DB_USER=sugu_kura_user
DB_PASSWORD=change-me-with-a-strong-database-password

# Origines locales. En production, remplacez par les domaines HTTPS réels.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Sécurité Django - laisser False en Docker local.
# En production HTTPS derrière Coolify/Traefik, utiliser True et HSTS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY_SSL_HEADER=False

# Auth / throttling
OWNER_TOKEN_MAX_AGE_SECONDS=43200
OWNER_LOGIN_THROTTLE_RATE=10/minute
CHECKOUT_CREATE_THROTTLE_RATE=30/hour
ORDER_CREATE_THROTTLE_RATE=60/hour
ORDER_TRACKING_THROTTLE_RATE=20/minute
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300

# Web Push
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com

# Gunicorn / Celery
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2

# Storefront - valeurs publiques, intégrées au build Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_PHONE=+22370000000
NEXT_PUBLIC_STORE_WHATSAPP=22370000000
NEXT_PUBLIC_STORE_EMAIL=contact@sugukura.com
